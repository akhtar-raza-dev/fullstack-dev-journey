<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Quora Posts</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
<div id="quora">
    <div class="header-container">
        <h1>Quora Posts</h1>
        <a href="/posts/new" class="new-post-btn">New Post</a>
    </div>

    <% for(post of posts) { %>
        <div class="post">
            <h3 class="user"><span style="color:darkred">@</span><%= post.username %></h3>

            <p class="content"><%= post.content %></p>

            <div class="post-actions">
                <a href="/posts/<%=post.id%>" class="action-link">See in details...</a>
                <a href="/posts/<%=post.id%>/edit" class="action-link">Edit post</a>

                <form action="/posts/<%= post.id%>/?_method=DELETE" method="POST" class="delete-form">
                    <button type="submit" class="delete-btn">Delete</button>
                </form>
            </div>
        </div>
    <% } %>
</div>
</body>
</html>